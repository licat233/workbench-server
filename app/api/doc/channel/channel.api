@server(
	jwt: Auth
	middleware: Jwt, Casbin, OperationRecord
	group: channel
    prefix: /v1/channel
)
service app-api {
	@doc(
		summary: "渠道"
	)
	@handler GetChannelList
	get /channelList(ListReq) returns(BaseResp)
}