info(
	title: "落地页"
	author: "licat"
	email: "1697470538@qq.com"
	version: "v1"
)
@server(
	jwt: Auth
	middleware: Jwt, Casbin, OperationRecord
	group: landingPage
    prefix: /v1/landingPage
)
service app-api {
	@doc(
		summary: "着陆页"
	)
	@handler LandingPageList
	get /landingPageList(ListReq) returns(BaseResp)
}