@server(
	jwt: Auth
	middleware: JwtMiddleware,CasbinMiddleware,OperationRecordMiddleware
	group: teacher
    prefix: /v1/teacher
)
service app-api {
	@doc(
		summary: "老师"
	)
	@handler GetTeacherList
	get /teacherList(ListReq) returns(BaseResp)
}