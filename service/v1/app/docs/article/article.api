@server(
	jwt: Auth
	middleware: JwtMiddleware,CasbinMiddleware,OperationRecordMiddleware
	group: article
    prefix: /v1/article
)
service app-api {
	@doc(
		summary: "推文"
	)
	@handler ArticleList
	get /articleList(ListReq) returns(BaseResp)
}