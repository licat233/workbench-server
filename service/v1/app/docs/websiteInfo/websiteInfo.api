@server(
	jwt: Auth
	middleware: JwtMiddleware,CasbinMiddleware,OperationRecordMiddleware
	group: websiteInfo
    prefix: /v1/websiteInfo
)
service app-api {
	@doc(
		summary: "网站信息"
	)
	@handler getWebsiteInfo
	get / returns(BaseResp)
}