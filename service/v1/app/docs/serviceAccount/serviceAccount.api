@server(
	jwt: Auth
	middleware: JwtMiddleware,CasbinMiddleware,OperationRecordMiddleware
	group: serviceAccount
	prefix: /v1/serviceAccount
)
service app-api {
	@doc(
		summary: "业务号"
	)
	@handler ServiceAccountList
	get /serviceAccountList(ListReq) returns(BaseResp)
}