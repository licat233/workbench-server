info(
	title: "广告账号"
	author: "licat"
	email: "1697470538@qq.com"
	version: "v1"
)

@server(
	jwt: Auth
	middleware: JwtMiddleware,CasbinMiddleware,OperationRecordMiddleware
	group: ad
    prefix: /v1/ad/account
)
service app-api {
	@doc(
		summary: "广告账户"
	)
	@handler GetAdAccountList
	get /list(ListReq) returns(BaseResp)
}