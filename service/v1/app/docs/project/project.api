@server(
	jwt: Auth
	middleware: JwtMiddleware,CasbinMiddleware,OperationRecordMiddleware
	group: project
    prefix: /v1/project
)
service app-api {
	@doc(
		summary: "项目"
	)
	@handler GetProjectList
	get /projectList(ListReq) returns(BaseResp)
}