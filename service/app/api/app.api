syntax = "v1"

info(
	title: "工作台系统"// TODO: add title
	desc: "all for work"// TODO: add description
	author: "licat"
	email: "1697470538@qq.com"
	version: "v1"
)

//---------common---------
//规范返回格式
type BaseResp {
	Success bool        `json:"success"`
	Message string      `json:"message"`
	Data    interface{} `json:"data"`
}
type DownloadReq {
	File string `path:"file"`
}
//通用的ID请求
type IdReq {
	Id int64 `json:"id"`
}

//通用的批量ID请求
type BatchIdReq {
	Id []int64 `json:"id"`
}

//通用页面数据请求
type ListReq {
	PageSize int64  `form:"pageSize,default=20,range=[1:1000]"` //页面大小
	Current  int64  `form:"current,default=1,range=[1:]"`       //当前页码
	KeyWord  string `form:"keyword,optional"`                   //关键词，可选
}

type JwtToken {
	AccessToken  string `json:"access_token"`
	AccessExpire int64  `json:"access_expire"`
}
//----------end common----------

//--------captcha----------
type CaptchaReq {
	//Height png height in pixel.
	Height int `json:"height"`

	// Width Captcha png width in pixel.
	Width int `json:"width"`

	//BgColor captcha image background color (optional)
	BgColor CaptchaBgColor `json:"BgColor"`
}
type EmailCaptchaReq {
	Address string `json:"address"` //接收验证码的邮箱地址
}
type CaptchaBgColor {
	R uint8 `json:"R"`
	G uint8 `json:"G"`
	B uint8 `json:"B"`
	A uint8 `json:"A"`
}
type CaptchaInfo {
	CaptchaKey  string `json:"captcha_key"`  //验证码Key
	Base64Image string `json:"base64_image"` //base46图片
}
type ProcessCaptchaReq {
	CaptchaKey string `json:"captcha_key"`
	Solution   string `json:"solution"`
}
//--------end captcha----------

//-----------log-------------
type LogListReq {
	Start    string `json:"start"`       //开始日期
	End      string `json:"end"`         //结束日期
	Ip       string `json:"ip,optional"` //IP
	PageSize int64  `json:"pageSize"`    //每页数量
	Current  int64  `json:"current"`     //当前页码
}
//-----------end log-------------

//---------user-----------
//用户注册，必须要有手机号码，邮箱用于验证(暂未实现邮箱验证码)，该注册接口可被关闭
type UserRegisterReq {
	Passport   string `json:"passport"`           //账号，只能为字母和数字的组合，不能有特殊符号
	Name       string `json:"real_name"`          //称呼，必须为真实姓名，中文名
	Email      string `json:"email"`              //邮箱
	Mobile     string `json:"mobile"`             //手机
	Gender     int64  `json:"gender,options=0|1"` //性别,默认男-0，女-1
	RoleId     int64  `json:"role_id"`            //角色ID
	CompanyId  int64  `json:"company_id"`         //公司ID
	QQ         string `json:"qq,optional"`        //QQ，选填
	Wechat     string `json:"wechat,optional"`    //微信，选填
	Password   string `json:"password"`           // 密码
	CaptchaKey string `json:"captcha_key"`        //验证码ID
	Solution   string `json:"solution"`           //验证码答案
}

//用户登陆，可用账号、手机号、邮箱登录，(暂未实现验证码登录功能)
type UserLoginReq {
	Passport   string `json:"passport"`
	Password   string `json:"password"`
	AutoLogin  bool   `json:"autoLogin,default=false"`
	CaptchaKey string `json:"captcha_key"` //验证码ID
	Solution   string `json:"solution"`    //验证码答案
}

//用户搜索，支持用户姓名、账号、邮箱、手机号
type UserSearchReq {
	PageSize int64  `form:"pageSize,default=20,range=[1:1000],optional"` //页面大小
	Current  int64  `form:"current,default=1,range=[1:],optional"`       //当前页码
	KeyWord  string `json:"keyword"`                                     //关键词，必填
}

type UserSearchKeyWord {
	UserRealName string `json:"UserRealName"`           // 用户姓名
	Avatar       string `json:"avatar"`                 // 用户头像
	UserGender   int64  `json:"UserGender,options=0|1"` // 用户性别,男是0，女是1
	Passport     string `json:"passport"`               // 账号
	Email        string `json:"email"`                  // 邮箱地址
	Mobile       string `json:"mobile"`                 // 电话号码
	QQ           string `json:"qq"`                     // 用户QQ
	Wechat       string `json:"wechat"`                 // 用户微信
	Description  string `json:"description"`            // 说明
}

//用户修改密码的请求
type UserPutPwdReq {
	OldPassword string `json:"oldPassword"` //新密码
	NewPassword string `json:"newPassword"` //旧密码
}

//用户修改手机号的请求
type UserPutMobileReq {
	UserMobile string `json:"userMobile"` //用户手机号
}

//用户修改邮箱的请求
type UserPutEmailReq {
	UserEmail string `json:"userEmail"` //用户邮箱
}

//用户操作自己信息的请求
type UserSelfInfoReq {
	RealName    string `json:"real_name"`          // 用户姓名
	RoleId      int64  `json:"role_id"`            // 外键，角色id
	Gender      int64  `json:"gender,options=0|1"` // 用户性别,男是0，女是1
	QQ          string `json:"qq"`                 // 用户QQ
	Wechat      string `json:"wechat"`             // 用户微信
	Description string `json:"description"`        // 说明
}

//管理员操作账户信息的请求
type UserInfoReq {
	Uid         int64  `json:"uid"`                // UID主键
	RealName    string `json:"real_name"`          // 用户姓名
	Avatar      string `json:"avatar"`             // 用户头像
	Gender      int64  `json:"gender,options=0|1"` // 用户性别,男是0，女是1
	Passport    string `json:"passport"`           // 账号
	Password    string `json:"password"`           // 密码
	Email       string `json:"email"`              // 邮箱地址
	Mobile      string `json:"mobile"`             // 电话号码
	RoleId      int64  `json:"role_id"`            // 外键，角色id
	CompanyId   int64  `json:"company_id"`         // 外键，所属公司id
	QQ          string `json:"qq"`                 // 用户QQ
	Wechat      string `json:"wechat"`             // 用户微信
	Status      int64  `json:"status"`             // 账号状态(默认0不可用状态)
	Description string `json:"description"`        // 说明
}

type UserAddReq {
	RealName    string `json:"real_name"`          // 用户姓名
	Avatar      string `json:"avatar"`             // 用户头像
	Gender      int64  `json:"gender,options=0|1"` // 用户性别,男是0，女是1
	Passport    string `json:"passport"`           // 账号
	Password    string `json:"password"`           // 密码
	Email       string `json:"email"`              // 邮箱地址
	Mobile      string `json:"mobile"`             // 电话号码
	RoleId      int64  `json:"role_id"`            // 外键，角色id
	CompanyId   int64  `json:"company_id"`         // 外键，所属公司id
	QQ          string `json:"qq"`                 // 用户QQ
	Wechat      string `json:"wechat"`             // 用户微信
	Status      int64  `json:"status"`             // 账号状态(默认0不可用状态)
	Description string `json:"description"`        // 说明
}

//用户的所有信息，备用
type UserAllInfo {
	Uid             int64  `json:"uid"`                // UID主键
	RealName        string `json:"real_name"`          // 用户姓名
	Avatar          string `json:"avatar"`             // 用户头像
	Gender          int64  `json:"gender,options=0|1"` // 用户性别,男是0，女是1
	Passport        string `json:"passport"`           // 账号
	Password        string `json:"password"`           // 密码
	Email           string `json:"email"`              // 邮箱地址
	Mobile          string `json:"mobile"`             // 电话号码
	RoleId          int64  `json:"role_id"`            // 外键，角色id
	UserRoleName    string `json:"role_name"`          // 角色昵称
	CompanyId       int64  `json:"company_id"`         // 外键，所属公司id
	UserCompanyName string `json:"company_name"`       // 所属公司名称
	QQ              string `json:"qq"`                 // 用户QQ
	Wechat          string `json:"wechat"`             // 用户微信
	Status          int64  `json:"status"`             // 账号状态(默认0不可用状态)
	CreateTime      string `json:"create_time"`        // 创建时间
	UpdateTime      string `json:"update_time"`        // 更新时间
	Description     string `json:"description"`        // 说明
}
//-------------end user---------------

//--------------rbac---------------
//策略请求
type PolicyReq {
	Sub string `json:"sub"`
	Dom string `json:"dom"`
	Obj string `json:"obj"`
	Act string `json:"act"`
}
type DomainReq {
	Domain string `json:"domain"`
}

//策略批量请求
type PoliciesReq {
	Rules []PolicyReq `json:"rules"`
}

type RoleAndDomainReq {
	Sub string `json:"sub"`
	Dom string `json:"dom"`
}
//-------------end rbac--------------

//----------role----------
//角色管理请求
type RoleReq {
	Rid         int64  `json:"rid"`
	Name        string `json:"name"`
	Status      int64  `json:"status"`
	Description string `json:"description"`
	Icon        string `json:"icon"`
}
//-----------end role-----------
//**********************************************分隔线*************************************************/
@server(
	group: storage
)
service app-api {
	@doc(
		summary: 文件下载
	)
	@handler DownloadHandler
	get /storage/:file(DownloadReq)
}

@server(
	group: captcha
)
service app-api {
	@doc(
		summary: "获取数学验证码"
	)
	@handler mathCaptcha
	post /v1/captcha/math(CaptchaReq) returns(BaseResp)
	
	@doc(
		summary: "验证码图片"
	)
	@handler showCaptcha
	get /v1/captcha/show
	
	@doc(
		summary: "验证码校验"
	)
	@handler processCaptcha
	post /v1/captcha/process(ProcessCaptchaReq) returns(BaseResp)
	
	@doc(
		summary: "获取发送邮箱验证码"
	)
	@handler emailCaptcha
	post /v1/captcha/email(EmailCaptchaReq) returns(BaseResp)
}

@server(
	group: common
	middleware: SafeWall
)
service app-api{
	@doc(
		summary: 上传图片文件接口
	)
	@handler UploadImgHandler
	post /v1/common/uploadImg returns(BaseResp)
	
	@doc(
		summary: 上传头像接口
	)
	@handler UploadAvatarHandler
	post /v1/common/uploadAvatar returns(BaseResp)
}

@server(
	jwt: Auth
	group: log
	middleware: Jwt, Casbin
)
service app-api {
	@doc(
		summary: "获取日志，根据参数，可获取所有日志、日期日志，IP日志"
	)
	@handler GetAllLog
	post /v1/log/all(LogListReq) returns(BaseResp)
	
	@doc(
		summary: "获取登录日志"
	)
	@handler GetLoginLog
	post /v1/log/login(LogListReq) returns (BaseResp)
}

@server(
	jwt: Auth
	middleware: Jwt, Casbin, OperationRecord
	group: websiteConfig
)
service app-api {
	@doc(
		summary: "网站信息"
	)
	@handler WebsiteConfig
	get /v1/websiteConfig/info returns(BaseResp)
}

@server(
	group: user
)

service app-api {
	@doc(
		summary: 用户注册
	)
	
	@handler register
	post /v1/user/register(UserRegisterReq) returns(BaseResp)
}

@server(
	group: user
	middleware: OperationRecord
)
service app-api {
	@doc(
		summary: 用户登录
	)
	@handler login
	post /v1/user/login(UserLoginReq) returns(BaseResp)
}

@server(
	jwt: Auth
	group: user
	middleware: Jwt, Casbin, OperationRecord
)
service app-api {
	@doc(
		summary: "用户搜索"
	)
	@handler searchUser
	get /v1/user/search(UserSearchReq) returns(BaseResp)
	
	@doc(
		summary: "注销登陆、退出，管理员可主动提出"
	)
	@handler logout
	get /v1/user/logout returns(BaseResp)
	
	@doc  "获取用户列表"
	@handler getUserList
	get /v1/user/userList(ListReq) returns(BaseResp)
	
	@doc  "修改自己的密码，修改后JWT失效，需要重新登录"
	@handler putCurrentUserPassword
	post /v1/user/currentPassword(UserPutPwdReq) returns(BaseResp)
	
	@doc  "修改自己的手机号"
	@handler putCurrentUserMobile
	post /v1/user/currentMobile(UserPutMobileReq) returns(BaseResp)
	
	@doc  "修改自己的邮箱"
	@handler putCurrentUserEmail
	post /v1/user/currentEmail(UserPutEmailReq) returns(BaseResp)
	
	@doc  "修改自己的头像"
	@handler putCurrentUserAvatar
	post /v1/user/currentAvatar returns(BaseResp)
	
	// restFull
	
	@doc  "获取用户自己的信息"
	@handler getCurrentUserInfo
	get /v1/user/currentInfo returns(BaseResp)
	
	@doc(
		summary: "修改用户自己的信息"
	)
	@handler putCurrentUserInfo
	put /v1/user/currentInfo(UserSelfInfoReq) returns(BaseResp)
	
	@doc(
		summary: "删除用户自己的账户"
	)
	@handler delCurrentUserInfo
	delete /v1/user/currentInfo returns(BaseResp)
	
	@doc(
		summary: "获取指定ID用户"
	)
	@handler getUser
	get /v1/user(IdReq) returns(BaseResp)
	
	@doc(
		summary: "添加用户"
	)
	@handler addUser
	post /v1/user(UserAddReq) returns(BaseResp)
	
	@doc(
		summary: "修改用户"
	)
	@handler putUser
	put /v1/user(UserInfoReq) returns(BaseResp)
	
	@doc(
		summary: "删除用户"
	)
	@handler delUser
	delete /v1/user(BatchIdReq) returns(BaseResp)
	// end-restFull
}

@server(
	jwt: Auth
	middleware: Jwt, Casbin, OperationRecord
	group: rbac
)
service app-api {
	@doc(
		summary: "获取授权规则通过角色ID"
	)
	@handler getPolicyByRoleId
	get /v1/rbac/getPolicyByRoleId(IdReq) returns(BaseResp)
	
	@doc(
		summary: "增加授权规则"
	)
	@handler AddPolicy
	post /v1/rbac/addpolicy(PolicyReq) returns(BaseResp)
	
	@doc(
		summary: "批量添加授权规则"
	)
	@handler AddPolicies
	post /v1/v1/rbac/addPolicies(PoliciesReq) returns(BaseResp)
	
	@doc(
		summary: "删除授权规则"
	)
	@handler RemovePolicy
	post /v1/rbac/removePolicy(PolicyReq) returns(BaseResp)
	
	@doc(
		summary: "批量删除授权规则"
	)
	@handler RemovePolicies
	post /v1/rbac/removePolicies(PoliciesReq) returns(BaseResp)
	
	@doc(
		summary: "获取当前策略中显示的操作列表"
	)
	@handler GetAllActions
	get /v1/rbac/getAllActions returns(BaseResp)
	
	@doc(
		summary: "获取策略中的所有授权规则"
	)
	@handler GetPolicy
	get /v1/rbac/getPolicy returns(BaseResp)
	
	@doc(
		summary: "获取当前策略中显示的 object 列表"
	)
	@handler GetAllObjects
	get /v1/rbac/GetAllObjects returns(BaseResp)
	
	@doc(
		summary: "将获得所有与该域相关联的用户"
	)
	@handler GetAllUsersByDomain
	get /v1/rbac/GetAllUsersByDomain(DomainReq) returns(BaseResp)
	
	@doc(
		summary: "获取域内用户或角色的权限"
	)
	@handler GetPermissionsForUserInDomain
	get /v1/rbac/GetPermissionsForUserInDomain(RoleAndDomainReq) returns(BaseResp)
}

@server(
	jwt: Auth
	middleware: Jwt, Casbin, OperationRecord
	group: menu
