	@handler getBaseMenuTree
	get /v1/menu/getBaseMenuTree returns(BaseResp)
	
	@handler addBaseMenu
	post /v1/menu/addBaseMenu returns(BaseResp)
	
	@handler deleteBaseMenu
	post /v1/menu/deleteBaseMenu returns(BaseResp)
	
	@handler updateBaseMenu
	post /v1/menu/updateBaseMenu returns(BaseResp)
	
	@handler getBaseMenuById
	get /v1/menu/getBaseMenuById returns(BaseResp)
}

